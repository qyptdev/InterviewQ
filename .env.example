# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-string-in-production

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=default

# Database
DATABASE_URL=sqlite:///./data/interview.db

# LLM API Configuration
# Primary model (complex tasks: planning, evaluation)
LLM_PRIMARY_BASE_URL=YOUR_LLM_API_BASE_URL (For Example: https://example.com/v1)
LLM_PRIMARY_API_KEY=YOUR_API_KEY_HERE
LLM_PRIMARY_MODEL=YOUR_PRIMARY_MODEL_NAME

# Light model (simple tasks: summarization, classification)
LLM_LIGHT_BASE_URL=YOUR_LLM_API_BASE_URL
LLM_LIGHT_API_KEY=YOUR_API_KEY_HERE
LLM_LIGHT_MODEL=YOUR_LIGHT_MODEL_NAME

# Embedding model
LLM_EMBEDDING_BASE_URL=YOUR_LLM_API_BASE_URL
LLM_EMBEDDING_API_KEY=YOUR_API_KEY_HERE
LLM_EMBEDDING_MODEL=YOUR_EMBEDDING_MODEL_NAME

# LLM Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=32000

# Rate Limiting (optional)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=30
